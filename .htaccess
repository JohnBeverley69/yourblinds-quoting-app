# Block direct access to .env and .env.example (and any .env* variants)
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Block direct access to other sensitive dotfiles and config files
<FilesMatch "^(\.htaccess|\.gitignore|\.gitattributes|composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock|README\.md|CHANGELOG\.md)$">
    Require all denied
</FilesMatch>

# Block direct access to .sql files
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# Block direct access to the database folder
RedirectMatch 403 ^/database(/|$)

# Block direct access to the vendor folder
RedirectMatch 403 ^/vendor(/|$)

# Block direct access to the _partials folder (server-side includes only)
RedirectMatch 403 ^/_partials(/|$)

# Block the server-side library folder (vendored code, include-only).
RedirectMatch 403 ^/_lib(/|$)

# Block the seed CSVs — these are SUPPLIER WHOLESALE PRICE LISTS.
#
# Anchored on the DIRECTORY NAME, not on the root, because anchoring it to the
# root is what broke it: #943 moved seed_data from / to /setup/seeds/seed_data,
# the old root-anchored rule kept matching only the old path, and the files went
# back to being served to anyone who asked. Verified live: the old URL 403'd
# while the new one returned 200 and 70 KB of wholesale pricing, no login.
# Matching the folder wherever it sits means the next tidy-up cannot undo it.
#
# These are static files: unlike everything else under setup/, which is PHP and
# redirects to the login page, nothing else was standing between them and the
# open web.
RedirectMatch 403 (^|/)seed_data(/|$)

# Belt and braces for the same tree: no CSV anywhere under setup/ should ever be
# fetchable, whatever it is called or wherever it is moved to next.
RedirectMatch 403 ^/setup/.*\.csv$

# Block direct access to the .git folder
RedirectMatch 403 ^/\.git(/|$)

# Dev-only helper scripts — not part of the app.
RedirectMatch 403 ^/tools(/|$)

# Supplier price lists uploaded by tenants. Served only through the
# super-admin viewer (master-admin/supplier-request-file.php, which reads
# the file from disk), never straight off the web.
RedirectMatch 403 ^/uploads/supplier-requests(/|$)

# Browser security headers: no framing by other sites (clickjacking), no
# MIME sniffing, HTTPS-only, and don't leak full URLs (public quote tokens)
# in the Referer header to third parties.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
